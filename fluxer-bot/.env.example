# Everything in here needs to be provided as a docker env variable param

DEV_FLAG=1

FLUXER_GUILD_ID="fluxer-community-id"
FLUXER_TOKEN="fluxer-bot-token"

# Prefix for text commands (e.g. !link-accounts); defaults to "!"
# FLUXER_COMMAND_PREFIX="!"

# Self-hosted Fluxer instance origin (e.g. https://fluxer.example.com). Leave unset to
# use the hosted fluxer.app instance.
# FLUXER_INSTANCE_URL="https://fluxer.example.com"

# Web API (reuses the same webapi BOT_USERNAME / BOT_PASSWORD service account as discord-bot)
WEBAPI_URL=http://localhost:3000
WEBAPI_USERNAME=bot
WEBAPI_PASSWORD=bot-password
