# Server
PORT=3000
NODE_ENV=development

# Database: mysql or sqlite
DB_TYPE=sqlite

# MySQL (when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=api_db

# SQLite (when DB_TYPE=sqlite). Path to .sqlite file. Default: data/api_template.sqlite
DB_FILE=./data/api_db.sqlite

# JWT (use a long random string in production; rotate if a token was ever committed to git)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Set true to overwrite service-account passwords from env on every boot (default: only on create)
# SYNC_SERVICE_PASSWORDS=true

# Admin panel login
ADMIN_USERNAME=user
ADMIN_PASSWORD=password

# Bot service account (discord-bot should use these for WEBAPI_USERNAME/PASSWORD)
BOT_USERNAME=bot
BOT_PASSWORD=bot-password

# Public web-view service account (read-only leaderboard/pin routes)
WEBVIEW_USERNAME=website
WEBVIEW_PASSWORD=password

# CORS allowed origins (comma-separated hostnames or full origins).
# webapi is internal-only in production; CORS is for web-panel on the Docker network.
CORS_ORIGINS=192.168.0.2,dixbot-discord,localhost

# Authenticated API rate limit (requests per minute)
API_RATE_LIMIT_MAX=300

# Shared pin attachment files (defaults to ../discord-bot/files when unset)
# PIN_FILES_DIR=../discord-bot/files

# Bearer token Prometheus's scrape_config must send to GET /metrics (not a JWT - a static
# shared secret). Leave unset to disable /metrics (returns 503).
# METRICS_TOKEN=change-me

# Dev-mode guild_config seed (npm run dev only; skipped once guild_config has any rows)
DISCORD_GUILD_ID=
SEED_CONFIG_TWITTER_FIX_ENABLED=true
SEED_CONFIG_PIN_THRESHOLD=1
SEED_CONFIG_PIN_EMOJI=📌
SEED_CONFIG_REPOST_EMOJI=
SEED_CONFIG_ANNOUNCE_CHANNEL_ID=
SEED_CONFIG_PIN_CHANNEL_ID=
SEED_CONFIG_PLUSPLUS_EMOJI=
SEED_CONFIG_MINUSMINUS_EMOJI=
SEED_CONFIG_PIN_MESSAGE_ROLE_IDS=[""]
SEED_CONFIG_USER_MAPPING_IMPORT_CHANNEL_ID=
SEED_CONFIG_TRIGGER_RESPONSES_ENABLED=true
SEED_CONFIG_REMINDERS_ENABLED=true
SEED_CONFIG_EIGHT_BALL_ENABLED=true
SEED_CONFIG_EMOJI_TRACKING_ENABLED=true
SEED_CONFIG_STICKER_TRACKING_ENABLED=true
SEED_CONFIG_PLUSPLUS_ENABLED=true
SEED_CONFIG_REPOST_DETECTION_ENABLED=true
SEED_CONFIG_PIN_SYSTEM_ENABLED=true