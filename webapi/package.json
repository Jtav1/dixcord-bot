{
  "name": "dixcord-bot-webapi",
  "version": "3.1.0",
  "description": "Express.js REST API for the dixcord-bot",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:init:mysql": "node scripts/mysql/initialize.js",
    "db:import:mysql": "node scripts/mysql/import.js",
    "db:setup:mysql": "node scripts/mysql/setup.js",
    "db:setup:sqlite": "node scripts/sqlite/setup.js",
    "db:seed:trigger-responses": "node scripts/sqlite/seed-trigger-responses.js",
    "db:seed:trigger-responses:mysql": "node scripts/mysql/seed-trigger-responses.js",
    "db:migrate:mysql": "node scripts/mysql/setup.js",
    "db:migrate:sqlite": "node scripts/sqlite/setup.js",
    "docs:generate": "node scripts/write-openapi.js",
    "docs:preview": "npm run docs:generate && scalar document serve openapi.generated.json --watch",
    "docs:build": "npm run docs:generate && scalar document validate openapi.generated.json"
  },
  "keywords": [
    "express",
    "mysql",
    "jwt",
    "rest-api"
  ],
  "license": "MIT",
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.18",
    "bcryptjs": "^3.0.3",
    "chrono-node": "^2.10.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "@prometheus-io/client": "^0.16.1",
    "swagger-jsdoc": "^6.3.0"
  },
  "devDependencies": {
    "@scalar/cli": "^2.0.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
